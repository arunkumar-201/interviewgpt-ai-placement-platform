# ─── Application ───────────────────────────────────────────────────────────
NODE_ENV=development

# ─── API Server ──────────────────────────────────────────────────────────────
PORT=4000
API_URL=http://localhost:4000
FRONTEND_URL=http://localhost:5173

# ─── Cookies (set COOKIE_SECURE=true in production behind HTTPS) ─────────────
COOKIE_SECURE=false

# ─── Password reset token TTL (hours) ────────────────────────────────────────
PASSWORD_RESET_EXPIRES_HOURS=1

# ─── Frontend (Vite) ─────────────────────────────────────────────────────────
VITE_API_URL=http://localhost:4000/api/v1

# ─── Database ────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://interviewgpt:interviewgpt_secret@localhost:5432/interviewgpt?schema=public

# ─── Redis ───────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ─── JWT (generate with: openssl rand -base64 32) ───────────────────────────
JWT_ACCESS_SECRET=change-me-access-secret-min-32-characters-long
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-characters-long
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ─── Google OAuth (Phase 2) ──────────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:4000/api/v1/auth/google/callback

# ─── GitHub OAuth (Phase 8) ──────────────────────────────────────────────────
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=http://localhost:4000/api/v1/github/callback

# ─── AI — Gemini (Phase 5+) ──────────────────────────────────────────────────
GEMINI_API_KEY=

# ─── Judge0 (Phase 5) ────────────────────────────────────────────────────────
JUDGE0_API_URL=https://judge0-ce.p.rapidapi.com
JUDGE0_API_KEY=
JUDGE0_RAPIDAPI_HOST=judge0-ce.p.rapidapi.com

# ─── AWS S3 (Phase 6) ────────────────────────────────────────────────────────
AWS_REGION=ap-south-1
AWS_S3_BUCKET=interviewgpt-resumes
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# ─── Email (Phase 2) ─────────────────────────────────────────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=noreply@interviewgpt.dev

# ─── Admin Seed (Phase 2) ────────────────────────────────────────────────────
ADMIN_EMAIL=admin@interviewgpt.dev
ADMIN_PASSWORD=ChangeMeAdmin1
ADMIN_NAME=Platform Admin
